 #include <linux/fs.h>
 #include <linux/nsproxy.h>
 #include <linux/sched/task.h>
@@ -62,4 +63,5 @@ void ksu_seccomp_allow_cache(struct seccomp_filter *filter, int nr)
         set_bit(nr, filter->cache.allow_compat);
